#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* macOS swaps Cmd/Ctrl: send LG for shortcuts that should act as Ctrl. */

/ {
    behaviors {
        mclk_lt: mclk_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        mc_ht: mission_control_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        ble_clear_hold: ble_clear_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&clear_bluetooth>, <&none>;
        };
    };

    macros {
        clear_bluetooth: clear_bluetooth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    combos {
        compatible = "zmk,combos";

        delete_combo {
            timeout-ms = <50>;
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
            layers = <0>;
        };

        mission_control {
            timeout-ms = <50>;
            bindings = <&kp LG(UP)>;
            key-positions = <30 31>;
            layers = <0>;
        };

        bt_clear {
            bindings = <&ble_clear_hold 0 0>;
            key-positions = <30 31>;
            layers = <5>;
        };

        ble_settings {
            timeout-ms = <50>;
            bindings = <&mo 5>;
            key-positions = <44 45>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Binding order by physical coordinate:
         * r0: c0-c5, c8-c13
         * r1: c0-c5, c8-c13
         * r2: c0-c13
         * r3: c0-c8, c11-c13
         */
        layer_0 {
            display-name = "default";
            bindings = <
&kp TAB     &kp Q  &kp W     &kp E     &kp R        &kp T                                               &kp Y     &kp U     &kp I      &kp O     &kp P     &kp MINUS
&kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G                                               &kp H     &kp J     &kp K      &kp L     &kp SEMI  &kp ENTER
&kp LSHFT   &kp Z  &kp X     &kp C     &kp V        &kp B       &mc_ht LG(LEFT) LANGUAGE_2  &mc_ht LG(RIGHT) LANGUAGE_1    &kp N     &kp M     &kp COMMA  &kp DOT   &kp UP    &kp FSLH
&kp LCTRL  &none  &kp LGUI  &kp LALT  &kp ESCAPE  &kp SPACE   &mo 3  &mo 4  &kp BSPC                    &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            display-name = "Pointer";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &mkp MB4   &mkp MB5   &trans                      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &mkp LCLK  &mkp RCLK  &mclk_lt 2 MCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans     &trans                      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans                          &trans                      &trans  &trans
            >;
        };

        layer_2 {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans                  &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "Extra";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                  &kp F7        &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6        &kp N7  &kp N8  &kp N9   &kp N0   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LA(TAB)  &trans  &trans        &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE                    &trans   &trans   &trans
            >;
        };

        layer_4 {
            display-name = "Function";
            bindings = <
&trans  &kp LS(N1)  &kp LS(FSLH)  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LS(N2)  &kp LS(N4)  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans                  &trans  &trans  &trans
            >;
        };

        layer_5 {
            display-name = "Bluetooth";
            bindings = <
&bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 3  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans                  &trans  &trans  &trans
            >;
        };
    };
};
